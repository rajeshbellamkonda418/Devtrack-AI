# Set a unique secret before deploying. Generate with:
# python -c "import secrets; print(secrets.token_hex(32))"
FLASK_SECRET_KEY=replace-with-a-random-secret

# Keep false for local HTTP development; set true when served over HTTPS.
SESSION_COOKIE_SECURE=false

# MongoDB Atlas or another MongoDB deployment URI.
MONGODB_URI=mongodb://localhost:27017
MONGODB_DB_NAME=devtrack_ai

# Configure these only when running migrate_to_mongodb.py.
# SOURCE_DB_BACKEND=sqlite
# SQLITE_PATH=database/applications.sqlite3
# For MySQL sources, set SOURCE_DB_BACKEND=mysql and DB_HOST, DB_PORT,
# DB_USER, DB_PASSWORD, and DB_NAME.
